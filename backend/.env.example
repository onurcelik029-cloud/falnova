# ── Sunucu ──
PORT=8787
PUBLIC_URL=https://api.falnova.app          # ses dosyası ve ödeme dönüş adresleri için herkese açık adres
NODE_ENV=production
JWT_SECRET=                                  # ZORUNLU (üretimde): openssl rand -hex 32
DB_PATH=./data/falnova.db
CORS_ORIGINS=*                               # üretimde alan adlarını yaz: https://falnova.app

# ── Yapay zekâ ──
# Anahtar boş bırakılırsa ilgili özellik sessizce içerik motoruna (mock) düşer — hiçbir uç hata vermez.
# Sağlayıcı sırası: kahve/el falı → önce OpenAI, olmazsa Gemini, olmazsa mock. Diğer tüm metin türleri
# (tarot, burç, rüya, kader, partner, doğum haritası yorumu, sohbet) → Gemini, olmazsa mock.
OPENAI_API_KEY=                              # Kahve falı + El falı (GPT-4o Vision)
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=                              # Tarot, burç, rüya, kader, partner, doğum haritası, el falı (yedek), sohbet
GEMINI_MODEL=gemini-3.6-flash
ELEVENLABS_API_KEY=                          # Sesli falcı
ELEVENLABS_VOICE_BILGE=                      # ElevenLabs Voice ID'leri (her ton için bir ses)
ELEVENLABS_VOICE_GIZEMLI=
ELEVENLABS_VOICE_FISILTI=

# ── Ödeme ──
PAYMENT_PROVIDER=mock                        # mock | stripe | iyzico (iyzico iskelet)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                       # Stripe → Webhooks → /webhooks/stripe (checkout.session.completed)
PAYMENT_SUCCESS_URL=falnova://wallet?status=success
PAYMENT_CANCEL_URL=falnova://wallet?status=cancel
# ALLOW_MOCK_PAYMENTS=1                      # yalnızca test: üretimde sahte ödemeyi açar (önerilmez)

# ── Mağaza İçi Satın Alma (IAP) ── Apple/Google mağaza kuralları gereği mobil kredi satışı
# Stripe değil IAP üzerinden yapılmalı; her ikisi de tanımlı değilse /wallet/iap/verify 501 döner.
APPLE_SHARED_SECRET=                         # App Store Connect → Uygulamalar → Uygulama İçi Satın Almalar → Paylaşılan Gizli Anahtar
ANDROID_PACKAGE_NAME=                        # ör. com.falnova.app
GOOGLE_SERVICE_ACCOUNT_JSON=                 # Play Console'da "Finansal veriler" izniyle oluşturulan servis hesabının tüm JSON içeriği (tek satır)

# ── Push bildirimleri (Expo Push) ── anahtar gerekmez; yalnızca uygulamanın kaydettirdiği jetona gönderilir
# PUSH_BASE_URL=                             # yalnızca test/geliştirme: Expo'nun push uç noktasının yerini alır
# PUSH_QUIET_START_HOUR=22                   # sessiz saatler başlangıcı (TR saati, 0-23)
# PUSH_QUIET_END_HOUR=9                      # sessiz saatler bitişi (TR saati, 0-23)
# DAILY_REMINDER_HOUR=19                     # günlük ritüel hatırlatmasının gönderildiği saat (TR)
# DAILY_REMINDER_ENABLED=1                   # '0' ile kapatılabilir (ör. geliştirme ortamında)

# ── Ürün ayarları ──
# READING_DELAY_SCALE=1                      # Bekleme ritüeli çarpanı (1 = normal, 0 = anında; testlerde 0)
# AUTH_RATE_LIMIT=20                         # Giriş/kayıt için dakikada istek sınırı (IP başına)
